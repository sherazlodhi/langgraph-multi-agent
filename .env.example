# ============================================================================
# Supervisor LLM Configuration (Azure OpenAI / Frontier Model)
# ============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-06-01

# Fallback OpenAI-compatible Supervisor settings (used if AZURE_OPENAI_* are unset)
SUPERVISOR_MODEL=gpt-4.1
SUPERVISOR_API_KEY=your-api-key-here
SUPERVISOR_BASE_URL=

# ============================================================================
# Worker LLM Configuration (Local Model via Ollama / LM Studio)
# ============================================================================
WORKER_MODEL=qwen2.5:1.5b
WORKER_API_KEY=ollama
WORKER_BASE_URL=http://localhost:11434/v1
